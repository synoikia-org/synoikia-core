{
  "name": "synoikia",
  "version": "0.15.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/check-node.mjs && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node --no-node-snapshot packages/core/dist/main.js",
    "workflow": "tsx --conditions=synoikia-source packages/create-plugin/src/cli.ts workflow",
    "hooks:install": "pnpm workflow hooks install",
    "arch:check": "likec4 validate docs/architecture",
    "arch:export": "likec4 export markdown docs/architecture",
    "arch:serve": "likec4 start docs/architecture"
  },
  "synoikia": {
    "workflow": {
      "securityPaths": [
        "packages/core/src/gate/**",
        "packages/core/src/sandbox/**",
        "packages/core/src/approvals/**",
        "packages/core/src/auth/**",
        "packages/core/src/crypto/**",
        "packages/core/src/plugins/**",
        "packages/core/src/http/**",
        "packages/core/src/runtime/**",
        "packages/core/src/instances/**",
        "packages/core/src/db/schema.ts",
        "packages/core/drizzle/**",
        "packages/plugin-sdk/src/**",
        "packages/create-plugin/**",
        "**/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "Dockerfile",
        ".github/workflows/**"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.5.0",
    "likec4": "~1.59.4",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
