{
  "name": "synoikia",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p .github/actions/prose && tsc -p scripts/release",
    "test": "node scripts/check-node.mjs && pnpm -r test && node --test .github/actions/prose/prose.test.mjs scripts/release/plan.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node --no-node-snapshot packages/core/dist/main.js",
    "prose": "node .github/actions/prose/check-prose.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "arch:check": "likec4 validate docs/architecture",
    "arch:export": "likec4 export markdown docs/architecture",
    "arch:serve": "likec4 start docs/architecture"
  },
  "synoikia": {
    "prose": [
      "*.md",
      "docs/**/*.md",
      "packages/**/*.md",
      "features/**/*.feature",
      ".claude/**/*.md"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@novibe-org/gherkin-lint-plus": "1.1.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.5.0",
    "likec4": "~1.59.4",
    "madr-lint": "0.4.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.5"
  }
}
