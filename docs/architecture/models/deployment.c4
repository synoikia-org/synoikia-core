deployment {
  zone internet 'Internet' {
    host proxy 'Reverse proxy' {
      description 'Terminates TLS and forwards the MCP listener, for example Caddy, Traefik or Cloudflare Tunnel.'
    }
  }
  zone lan 'LAN or VPN' {
    host docker 'Docker host' {
      runtime container 'Synoikia container' {
        technology 'ghcr.io/synoikia-org/synoikia, non-root'
        coreProcess = instanceOf synoikia.core {
          technology 'Node.js, --no-node-snapshot, --disable-sigusr1'
        }
        isolates = instanceOf synoikia.sandbox
        children = instanceOf synoikia.instance
        portal = instanceOf synoikia.adminPortal
      }
      runtime volume 'Data volume' {
        technology 'DATA_DIR'
        db = instanceOf synoikia.database
        installed = instanceOf synoikia.bundles
      }
    }
  }
  zone pluginCi 'Plugin repository CI' {
    host runner 'CI runner or author machine' {
      runtime vitest 'vitest' {
        technology 'Node.js, --no-node-snapshot'
        suite = instanceOf synoikia.coreTesting
        testCore = instanceOf synoikia.core
        testIsolates = instanceOf synoikia.sandbox
        testChild = instanceOf synoikia.instance
        testDb = instanceOf synoikia.database
      }
    }
  }
}
