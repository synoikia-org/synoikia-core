model {
  extend synoikia.core {
    mcpEndpoints = component 'MCP endpoints' {
      technology 'http/mcp'
      description 'The MCP listener: one endpoint for each instance, the OAuth authorization server and the approval page.'
    }
    adminApi = component 'Admin API' {
      technology 'http/admin'
      description 'The admin listener: the Admin API and the static portal, with session cookies and CSRF checks.'
    }
    metrics = component 'Metrics listener' {
      technology 'http/metrics, @prometheus-io/client'
      description 'The metrics listener: the metrics of core in the Prometheus text format, with an optional bearer token.'
    }
    auth = component 'Auth' {
      technology 'auth/'
      description 'Users, sessions, TOTP, OIDC, MCP tokens, OAuth grants and external providers, with an in-memory cache of the credentials that calls present.'
    }
    runtime = component 'Runtime' {
      technology 'runtime/'
      description 'Runs search and execute, queues a run briefly when too many run at once, and parks an execution that waits on an approval.'
    }
    gate = component 'Gate' {
      technology 'gate/'
      description 'The permission pipeline between a binding call and the plugin.'
    }
    approvals = component 'Approvals' {
      technology 'approvals/'
      description 'Requests, links and decisions of human approvals.'
    }
    instances = component 'Instance manager' {
      technology 'instances/'
      description 'Instance configuration, encrypted connection secrets and settings, with an in-memory cache of instances and their settings.'
    }
    pluginHost = component 'Plugin host' {
      technology 'plugins/'
      description 'Starts, supervises and restarts instance processes, stops an idle one until its next call, and installs verified bundles.'
    }
    catalogSync = component 'Catalog sync' {
      technology 'catalog/'
      description 'Syncs the catalog, groups and registry of each instance from its plugin, and keeps each catalog with its access levels in memory.'
    }
    notify = component 'Notifications' {
      technology 'events.ts, notify/'
      description 'The event bus and the notification channels.'
    }
    audit = component 'Audit log' {
      technology 'audit.ts'
      description 'Appends every call, search, configuration change, sign-in and plugin event.'
    }
    dbAccess = component 'Database access' {
      technology 'db/, Drizzle, better-sqlite3'
      description 'Opens the database, runs its migrations, counts the writes to each table and reuses prepared statements.'
    }
    crypto = component 'Secret box' {
      technology 'crypto/'
      description 'Encrypts and decrypts secrets with AES-256-GCM and keys derived from the master key.'
    }
  }

  synoikia.core.mcpEndpoints -> synoikia.core.auth 'authenticates the client and the approver with'
  synoikia.core.mcpEndpoints -> synoikia.core.runtime 'starts search, execute and resume in'
  synoikia.core.mcpEndpoints -> synoikia.core.approvals 'records decisions from the approval page in'
  synoikia.core.adminApi -> synoikia.core.auth 'signs admins in with'
  synoikia.core.adminApi -> synoikia.core.instances 'configures instances in'
  synoikia.core.adminApi -> synoikia.core.pluginHost 'installs plugins with'
  synoikia.core.runtime -> synoikia.sandbox 'runs model code in'
  synoikia.sandbox -> synoikia.core.gate 'sends binding calls to'
  synoikia.core.gate -> synoikia.core.approvals 'asks for human approval in'
  synoikia.core.gate -> synoikia.core.pluginHost 'resolves and invokes operations through'
  synoikia.core.gate -> synoikia.core.audit 'records each decision in'
  synoikia.core.pluginHost -> synoikia.instance 'sends operation calls to'
  synoikia.core.pluginHost -> pluginRepository 'downloads indexes and bundles from'
  synoikia.core.pluginHost -> synoikia.bundles 'installs bundles into'
  synoikia.core.pluginHost -> synoikia.core.audit 'warns of each refused debugger signal in'
  synoikia.core.pluginHost -> synoikia.core.instances 'reports each plugin message that breaks the contract to'
  synoikia.instance -> synoikia.core.pluginHost 'answers calls and sends log, catalog and heartbeat notices to'
  synoikia.core.instances -> synoikia.core.crypto 'encrypts connection secrets with'
  synoikia.core.instances -> synoikia.core.pluginHost 'starts and stops instances with'
  synoikia.core.gate -> synoikia.core.pluginHost 'starts an idle instance on a call through'
  synoikia.core.runtime -> synoikia.core.pluginHost 'starts an idle instance for a guide read through'
  synoikia.core.adminApi -> synoikia.core.pluginHost 'starts an idle instance for an option list through'
  synoikia.core.instances -> synoikia.core.runtime 'asks for the runs and parked executions of an instance in'
  synoikia.core.instances -> synoikia.core.approvals 'asks for the open approvals of an instance in'
  synoikia.core.adminApi -> synoikia.core.runtime 'sets the total of runs at once in'
  synoikia.core.catalogSync -> synoikia.core.pluginHost 'reads catalogs and registries through'
  synoikia.core.notify -> notificationReceiver 'sends events to'
  synoikia.core.auth -> identityProvider 'signs users in with'
  synoikia.core.mcpEndpoints -> synoikia.core.instances 'looks up the instance of each endpoint in'
  synoikia.core.gate -> synoikia.core.catalogSync 'reads operations and access levels from'
  synoikia.core.runtime -> synoikia.core.catalogSync 'reads the catalog for search from'
  synoikia.core.auth -> synoikia.core.dbAccess 'stores users, sessions and tokens through'
  synoikia.core.auth -> synoikia.core.dbAccess 'checks the write counters of its cached tables in'
  synoikia.core.approvals -> synoikia.core.dbAccess 'stores pending approvals through'
  synoikia.core.audit -> synoikia.core.dbAccess 'appends through'
  synoikia.core.catalogSync -> synoikia.core.dbAccess 'stores catalogs through'
  synoikia.core.catalogSync -> synoikia.core.dbAccess 'checks the write counters of its cached tables in'
  synoikia.core.instances -> synoikia.core.dbAccess 'stores instances through'
  synoikia.core.instances -> synoikia.core.dbAccess 'checks the write counters of its cached tables in'
  synoikia.core.dbAccess -> synoikia.database 'reads and writes'
  prometheus -> synoikia.core.metrics 'scrapes metrics from' {
    technology 'Prometheus text format, HTTP'
  }
}
