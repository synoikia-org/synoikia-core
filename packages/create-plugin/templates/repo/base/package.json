{
  "name": "{{repoName}}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "new": "synoikia-plugin new",
    "build": "pnpm -r --filter './plugins/*' build",
    "check": "synoikia-plugin check",
    "typecheck": "pnpm -r --filter './plugins/*' typecheck",
    "test": "pnpm -r --filter './plugins/*' test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "workflow": "synoikia-plugin workflow",
    "hooks:install": "synoikia-plugin workflow hooks install"
  },
  "synoikia": {
    "repository": "{{repository}}",
    "name": "{{repoName}}",
    "workflow": {
      "securityPaths": [
        "plugins/*/manifest.json",
        "plugins/*/plugin.yaml",
        "plugins/*/src/**",
        "plugins/*/test/compliance.yaml",
        "plugins/*/test/fake*.ts",
        "plugins/*/test/fixtures/**",
        "plugins/*/features/**",
        "plugins/*/vitest.config.ts",
        "plugins/*/instructions.md",
        "plugins/*/guides/**",
        "vitest.shared.ts",
        "**/package.json",
        ".github/workflows/**",
        ".gitleaks.toml",
        ".claude/agents/**",
        ".claude/hooks/**",
        ".claude/settings.json",
        "minisign.pub",
        "pnpm-workspace.yaml",
        "pnpm-lock.yaml"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@synoikia/core": "{{coreRange}}",
    "@synoikia/create-plugin": "{{cliRange}}",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
