{
  "extraKnownMarketplaces": {
    "synoikia-dev-kit": {
      "source": {
        "source": "github",
        "repo": "synoikia-org/synoikia-dev-kit"
      }
    }
  },
  "enabledPlugins": {
    "synoikia-plugin-dev@synoikia-dev-kit": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
