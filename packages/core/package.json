{
  "name": "@synoikia/core",
  "version": "0.20.1",
  "description": "Core process: MCP endpoints, Admin API, plugin host, permission gate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synoikia-org/synoikia-core.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    "./testing": {
      "synoikia-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/compliance": {
      "synoikia-source": "./src/testing/compliance/index.ts",
      "types": "./dist/testing/compliance/index.d.ts",
      "import": "./dist/testing/compliance/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/testing/compliance/suite','dist/testing/compliance/suite',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:features": "vitest run --project features",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@node-rs/argon2": "^2.2.1",
    "@synoikia/plugin-sdk": "workspace:^",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "isolated-vm": "~6.2.0",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/semver": "^7.8.0",
    "drizzle-kit": "^0.31.11",
    "quickpickle": "1.11.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "quickpickle": "^1.11.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "quickpickle": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "publishConfig": {
    "access": "public"
  }
}
